# Firebase credentials. Use ONE of these:
#  - local: path to the service account key file (never commit it)
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/firebase-service-account.json"
#  - Vercel: the key file contents, base64 encoded (base64 -w0 key.json)
FIREBASE_SERVICE_ACCOUNT=
PORT=8001

# Set to true when served over HTTPS (also enabled automatically when NODE_ENV=production)
COOKIE_SECURE=false

# Email notifications (optional). Leave SMTP_HOST empty to disable.
NOTIFY_EMAIL=iluito@binus.edu
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public site address, used for the dashboard link in emails
PUBLIC_URL=
